<!--pages/nbstudy/admin-attendance-calendar/index.wxml-->
<navigation-bar title="日历签到管理" back="{{true}}"></navigation-bar>

<view class="container">
  <!-- 日期选择器 -->
  <view class="date-selector-container">
    <picker mode="date" value="{{selectedDate}}" start="2020-01-01" end="2099-12-31" bindchange="onDateChange">
      <view class="date-picker">
        <text class="date-label">选择日期：</text>
        <text class="date-value">{{selectedDate}} {{weekdayText}}</text>
        <text class="date-arrow">▼</text>
      </view>
    </picker>
  </view>

  <!-- 统计信息 -->
  <view class="statistics-container">
    <text class="statistics-text">今日签到学生 ({{attendanceList.length}}人)</text>
  </view>

  <!-- 签到学生列表 -->
  <view class="scroll-container">
    <scroll-view 
      class="scroll-ui" 
      type="list" 
      scroll-y 
      show-scrollbar="{{false}}">
      <view class="attendance-cell" wx:for="{{attendanceList}}" wx:key="_id">
        <view class="avatar-container">
          <image class="avatar" src="{{item.avatarUrl}}"></image>
        </view>
        <view class="info">
          <block wx:if="{{programMode!='private'}}">
            <view class="name">{{item.studentName}}</view>
          </block>
          <block wx:else>
            <view class="name">{{item.nickname}}</view>
          </block>
          <block wx:if="{{item.durationType === '0'}}">
            <view class="card-info">次卡剩余: {{item.cardRemainingCount || 0}}次</view>
          </block>
        </view>
        <view class="delete-btn" bindtap="onDeleteAttendance" data-index="{{index}}" data-id="{{item._id}}">
          <text class="delete-icon">×</text>
        </view>
      </view>
      <view wx:if="{{attendanceList.length === 0}}" class="empty-tip">
        <text>暂无签到记录</text>
      </view>
      <view class="extra-space"></view>
    </scroll-view>
  </view>

  <!-- 添加签到按钮 -->
  <view class="add-button" bindtap="onAddAttendance">
    <text class="add-icon">+</text>
    <text class="add-text">添加签到学生</text>
  </view>
</view>

<!-- 学生选择弹窗 -->
<view class="modal-mask {{showStudentPicker ? 'show' : ''}}" bindtap="onCloseStudentPicker">
  <view class="modal-content" catchtap="stopPropagation">
    <view class="modal-header">
      <text class="modal-title">选择学生</text>
      <text class="modal-close" bindtap="onCloseStudentPicker">×</text>
    </view>
    <view class="search-container">
      <input class="search-input" placeholder="搜索学生姓名" value="{{searchKeyword}}" bindinput="onSearchInput" />
    </view>
    <scroll-view class="student-list" scroll-y>
      <view 
        class="student-item {{item.selected ? 'selected' : ''}}" 
        wx:for="{{filteredStudentList}}" 
        wx:key="_id"
        bindtap="onSelectStudent" 
        data-index="{{index}}">
        <view class="avatar-container-small">
          <image class="avatar-small" src="{{item.avatarUrl}}"></image>
        </view>
        <view class="student-info">
          <block wx:if="{{programMode!='private'}}">
            <text class="student-name">{{item.studentName}}</text>
          </block>
          <block wx:else>
            <text class="student-name">{{item.nickname}}</text>
          </block>
          <block wx:if="{{item.durationType === '0'}}">
            <text class="student-card-info">次卡剩余: {{item.cardRemainingCount || 0}}次</text>
          </block>
        </view>
        <view wx:if="{{item.selected}}" class="check-icon">✓</view>
      </view>
      <view wx:if="{{filteredStudentList.length === 0}}" class="empty-tip">
        <text>未找到学生</text>
      </view>
    </scroll-view>
    <view class="modal-footer">
      <button class="cancel-btn" bindtap="onCloseStudentPicker">取消</button>
      <button class="confirm-btn" bindtap="onConfirmAddAttendance">确定</button>
    </view>
  </view>
</view>

